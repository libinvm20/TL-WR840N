+/* Wi-Fi QR code: scan with a phone camera to join. Uses the 2.4GHz settings (rt_*). */
+function wifiQRText(){
+	var am = document.form.rt_auth_mode.value, wep = parseInt(document.form.rt_wep_x.value) || 0, ssid, pass, hid;
+	try {
+		ssid = decodeURIComponent(document.getElementById('qr_ssid').value);
+		pass = decodeURIComponent(document.getElementById('qr_psk').value);
+	} catch (e) {
+		return '';
+	}
+	hid = (document.getElementById('qr_closed').value == '1') ? 'H:true;' : '';
+	function esc(v){ return v.replace(/([\\;,:"])/g, '\\$1'); }
+	if (!ssid)
+		return '';
+	if (am == 'open' && wep == 0)
+		return 'WIFI:T:nopass;S:' + esc(ssid) + ';' + hid + ';';
+	if (am == 'psk' && pass)
+		return 'WIFI:T:WPA;S:' + esc(ssid) + ';P:' + esc(pass) + ';' + hid + ';';
+	return '';
+}
+
+function makeWifiQR(){
+	var box = document.getElementById('wifi_qr_box'), el = document.getElementById('wifi_qr'), t = wifiQRText();
