+<!DOCTYPE html>
+<html>
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta http-equiv="Pragma" content="no-cache">
+<meta http-equiv="Expires" content="-1">
+<title>Login</title>
+<link rel="shortcut icon" href="/images/favicon.ico">
+<style>
+html{color-scheme:dark}
+body{margin:0;background:#181818;color:#ddd;font:14px Arial,Helvetica,sans-serif;display:flex;min-height:100vh;align-items:center;justify-content:center}
+.box{width:300px;max-width:90%;background:#262626;border:1px solid #444;border-radius:6px;padding:22px 24px;text-align:center}
+.box img{width:150px;height:71px}
+h1{font-size:15px;font-weight:normal;color:#aaa;margin:6px 0 16px}
+input{display:block;box-sizing:border-box;width:100%;margin:0 0 10px;padding:8px 10px;background:#111;color:#ddd;border:1px solid #444;border-radius:4px;font-size:14px}
+input:focus{outline:0;border-color:#8e44f0}
+button{width:100%;padding:9px;border:1px solid #6d28d9;border-radius:4px;background:linear-gradient(#8e44f0,#6d28d9);color:#fff;font-size:14px;cursor:pointer}
+button:disabled{opacity:.6;cursor:default}
+#err{min-height:18px;color:#e07a78;margin:2px 0 8px}
+a{color:#a58bd6;font-size:12px;text-decoration:none}
+</style>
+<script>
+function doLogin(){
+	var u = document.getElementById('u').value, p = document.getElementById('p'),
+	    e = document.getElementById('err'), b = document.getElementById('b'), x = new XMLHttpRequest();
+	e.textContent = '';
+	b.disabled = true;
+	x.open('GET', '/system_status_data.asp?xhr=1&_=' + new Date().getTime(), true, u, p.value);
+	x.onreadystatechange = function(){
+		if (x.readyState != 4)
+			return;
+		b.disabled = false;
+		if (x.status == 200)
+			location.replace('/index.asp');
+		else {
+			e.textContent = 'Wrong username or password.';
+			p.select();
+		}
+	};
+	x.send(null);
+	return false;
+}
+</script>
+</head>
+<body onload="document.getElementById('p').focus();">
+<form class="box" onsubmit="return doLogin();">
+	<img src="/bootstrap/img/libin_logo.png" alt="">
+	<h1>Sign in to your router</h1>
+	<input id="u" type="text" value="admin" autocomplete="username" autocapitalize="off">
+	<input id="p" type="password" placeholder="Password" autocomplete="current-password">
+	<div id="err"></div>
+	<button id="b" type="submit">Sign in</button>
+	<p><a href="/index.asp?xhr=1">Use browser login</a></p>
+</form>
+</body>
+</html>
