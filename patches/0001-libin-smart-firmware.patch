+	q = document.createElement('div');
+	q.style.cssText = 'background:#fff;padding:12px;border-radius:6px;';
+	c = document.createElement('div');
+	c.style.cssText = 'color:#ddd;margin-top:10px;font-size:13px;';
+	c.textContent = 'Scan to join Wi-Fi. Click anywhere to close.';
+	o.appendChild(q);
+	o.appendChild(c);
+	o.onclick = function(){ document.body.removeChild(o); };
+	document.body.appendChild(o);
+	new QRCode(q, {text: t, width: 256, height: 256, colorDark: '#000000', colorLight: '#ffffff', correctLevel: QRCode.CorrectLevel.M});
+}
