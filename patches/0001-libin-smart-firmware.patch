diff --git a/trunk/user/scripts/devusage.sh b/trunk/user/scripts/devusage.sh
new file mode 100755
index 0000000..229158b
--- /dev/null
+++ b/trunk/user/scripts/devusage.sh
@@ -0,0 +1,183 @@
+#!/bin/sh
+#
+# Device Usage - live internet traffic per device, by Libin
+#
+# Reads the connection table (conntrack) every few seconds and adds up the
+# bytes each LAN device sent (upload) and received (download). Offloaded
+# (Shortcut-FE) traffic is counted too, so routing speed is not affected.
+#
+# Result file for the web pages: /tmp/devusage.txt
+#   first line : #wan|wan_ip|connected_seconds|down_bps|up_bps
+#   then       : ip|mac|name|down_bps|up_bps|down_total_bytes|up_total_bytes
+#
+# nvram keys:  du_enable (1 = on, 0 = off)
+# Totals count from the last boot.
+
+TAG=devusage
+STATE=/tmp/devusage
+OUT=/tmp/devusage.txt
+PIDFILE=/var/run/devusage.pid
+LAN=br0
+CT=/proc/net/nf_conntrack
+POLL=5
+NICE=""
+command -v nice >/dev/null 2>&1 && NICE="nice -n 10"
+
+log() { logger -t "$TAG" "$*"; }
+
+# uptime in hundredths of a second, without starting another process
+cs() { read up _ < /proc/uptime; f="${up#*.}"; [ "${f%"${f#?}"}" = 0 ] && f="${f#0}"; CS=$(( ${up%.*} * 100 + ${f:-0} )); }
+
+run_once() {	# $1 = lan ip/prefix, $2 = wan ip, $3 = wan0_uptime stamp
+	$NICE awk -v lanc="$1" -v wanip="$2" -v wanstamp="$3" -v st="$STATE" -v out="$OUT" -v lan="$LAN" '
+	function ip2n(ip,   a) { split(ip, a, "."); return ((a[1]*256 + a[2])*256 + a[3])*256 + a[4] }
+	function inlan(ip) { if (ip in memo) return memo[ip]; return memo[ip] = (int(ip2n(ip) / blk) == int(lann / blk)) }
+	BEGIN {
+		split(lanc, lc, "/"); routerip = lc[1]; plen = lc[2] + 0
+		blk = 1; for (i = 0; i < 32 - plen; i++) blk *= 2
+		lann = ip2n(routerip)
+		if ((getline line < "/proc/uptime") > 0) { split(line, u, " "); now = u[1] + 0 }
+		close("/proc/uptime")
+		# previous sample time
+		pts = 0; if ((getline line < (st "/ts")) > 0) pts = line + 0; close(st "/ts")
+		dt = now - pts; seeded = (pts > 0 && dt > 0.5)
+		# previous flow counters
+		while ((getline line < (st "/flows")) > 0) { split(line, f, " "); pu[f[1]] = f[2] + 0; pd[f[1]] = f[3] + 0; hasprev[f[1]] = 1 }
+		close(st "/flows")
+		# totals and smoothed rates: ip tu td ru rd
+		while ((getline line < (st "/totals")) > 0) { split(line, t, " "); tu[t[1]] = t[2] + 0; td[t[1]] = t[3] + 0; ru[t[1]] = t[4] + 0; rd[t[1]] = t[5] + 0; known[t[1]] = 1 }
+		close(st "/totals")
+		# who is connected: ip -> mac, name
+		while ((getline line < "/proc/net/arp") > 0) {
+			split(line, a, " ")
+			if (a[6] == lan && a[3] == "0x2") { mac[a[1]] = tolower(a[4]); known[a[1]] = 1 }
+		}
+		close("/proc/net/arp")
+		while ((getline line < "/tmp/dnsmasq.leases") > 0) {
+			split(line, l, " ")
+			if (l[4] != "" && l[4] != "*") nm[l[3]] = l[4]
+		}
+		close("/tmp/dnsmasq.leases")
+		# WAN interface (default route) byte counters
+		wif = ""
+		while ((getline line < "/proc/net/route") > 0) { split(line, r, "\t"); if (r[2] == "00000000" && r[1] != "Iface") { wif = r[1]; break } }
+		close("/proc/net/route")
+		wrx = wtx = 0
+		if (wif != "") {
+			if ((getline line < ("/sys/class/net/" wif "/statistics/rx_bytes")) > 0) wrx = line + 0
+			close("/sys/class/net/" wif "/statistics/rx_bytes")
+			if ((getline line < ("/sys/class/net/" wif "/statistics/tx_bytes")) > 0) wtx = line + 0
+			close("/sys/class/net/" wif "/statistics/tx_bytes")
+		}
+		prx = ptx = prd = pru = 0
+		if ((getline line < (st "/wan")) > 0) { split(line, w, " "); prx = w[1] + 0; ptx = w[2] + 0; prd = w[3] + 0; pru = w[4] + 0 }
+		close(st "/wan")
+		fl = st "/flows.new"; printf "" > fl
+	}
+	$1 == "ipv4" {
+		ns = nd = nb = 0; sp = dp = idv = ""
+		# fast path: tcp/udp/icmp lines have a fixed layout (see nf_conntrack_standalone.c)
+		j = ($3 == "tcp" || $3 == "udp") ? 4 : (($3 == "icmp") ? 5 : 0)
+		if (j) {
+			i0 = ($6 ~ /^src=/) ? 6 : 7
+			bi = i0 + j + 1
+			if ($bi !~ /^bytes=/) next
+			i2 = bi + 1
+			if ($i2 == "[UNREPLIED]") i2++
+			bj = i2 + j + 1
+			if ($i2 !~ /^src=/ || $bj !~ /^bytes=/) next
+			s1 = substr($i0, 5); d1 = substr($(i0 + 1), 5); s2 = substr($i2, 5)
+			sp = $(i0 + 2); dp = $(i0 + 3); idv = (j == 5) ? $(i0 + 4) : ""
+			b1 = substr($bi, 7) + 0; b2 = substr($bj, 7) + 0
+			ns = 2; nb = 2
+		} else for (i = 4; i <= NF; i++) {
+			x = $i
+			if (x ~ /^src=/) { if (ns == 0) s1 = substr(x, 5); else if (ns == 1) s2 = substr(x, 5); ns++ }
+			else if (x ~ /^dst=/) { if (nd == 0) d1 = substr(x, 5); nd++ }
+			else if (x ~ /^sport=/) { if (sp == "") sp = substr(x, 7) }
+			else if (x ~ /^dport=/) { if (dp == "") dp = substr(x, 7) }
+			else if (x ~ /^id=/) { if (idv == "") idv = substr(x, 4) }
+			else if (x ~ /^bytes=/) { if (nb == 0) b1 = substr(x, 7) + 0; else if (nb == 1) b2 = substr(x, 7) + 0; nb++ }
+		}
+		if (nb < 2 || ns < 2) next
+		if (inlan(s1)) { if (inlan(d1)) next; dev = s1; up = b1; down = b2 }
+		else if (inlan(s2)) { dev = s2; down = b1; up = b2 }
+		else next
+		if (dev == routerip) next
+		key = $3 "," s1 "," d1 "," sp "," dp "," idv
+		print key, up, down >> fl
+		if (!seeded) next
+		if (key in hasprev) { du = up - pu[key]; dd = down - pd[key]; if (du < 0) du = up; if (dd < 0) dd = down }
+		else { du = up; dd = down }
+		gu[dev] += du; gd[dev] += dd; known[dev] = 1
+	}
+	END {
+		close(fl)
+		tf = st "/totals.new"; of = out ".tmp"; printf "" > tf; printf "" > of
+		wd = prd; wu = pru
+		if (seeded && prx > 0 && wrx >= prx && wtx >= ptx) {
+			wd = (prd + (wrx - prx) * 8 / dt) / 2; wu = (pru + (wtx - ptx) * 8 / dt) / 2
+			if (wd < 500) wd = 0
+			if (wu < 500) wu = 0
+		}
+		printf "%s %.0f %.0f %.0f %.0f\n", "", wrx, wtx, wd, wu > (st "/wan"); close(st "/wan")
+		printf "#wan|%s|%.0f|%.0f|%.0f\n", wanip, (wanstamp > 0 && now > wanstamp) ? now - wanstamp : 0, wd, wu >> of
+		for (ip in known) {
+			if (seeded) {
+				ir = gu[ip] * 8 / dt; id = gd[ip] * 8 / dt
+				ru[ip] = (ir + ru[ip]) / 2; rd[ip] = (id + rd[ip]) / 2
+				if (ru[ip] < 500) ru[ip] = 0
+				if (rd[ip] < 500) rd[ip] = 0
+				tu[ip] += gu[ip]; td[ip] += gd[ip]
+			}
+			if (ip in mac || tu[ip] + td[ip] > 0)
+				printf "%s|%s|%s|%.0f|%.0f|%.0f|%.0f\n", ip, mac[ip], (ip in nm) ? nm[ip] : "-", rd[ip], ru[ip], td[ip], tu[ip] >> of
+			printf "%s %.0f %.0f %.0f %.0f\n", ip, tu[ip], td[ip], ru[ip], rd[ip] >> tf
+		}
+		close(tf); close(of)
+		print now > (st "/ts"); close(st "/ts")
+	}' $CT
+	mv "$STATE/flows.new" "$STATE/flows" 2>/dev/null
+	mv "$STATE/totals.new" "$STATE/totals" 2>/dev/null
+	mv "$OUT.tmp" "$OUT" 2>/dev/null
+}
+
+case "$1" in
+daemon)
+	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then exit 0; fi
+	echo $$ > "$PIDFILE"
+	mkdir -p "$STATE"; rm -f "$STATE"/*
+	sleep 40
+	c=0; en=1; lc=""; wanip=""; wanstamp=0
+	while :; do
+		if [ $((c % 6)) -eq 0 ]; then	# slow-changing values, refreshed about every 30 s
+			en="$(nvram get du_enable)"
+			lc="$(ip -4 addr show dev $LAN 2>/dev/null | awk '/inet /{print $2; exit}')"
+			wanstamp="$(nvram get wan0_uptime)"
+			wif="$(awk '$2=="00000000" && $1!="Iface"{print $1; exit}' /proc/net/route 2>/dev/null)"
+			wanip=""
+			[ -n "$wif" ] && wanip="$(ip -4 addr show dev "$wif" 2>/dev/null | awk '/inet /{split($2,a,"/"); print a[1]; exit}')"
+			[ "$(cat /proc/sys/net/netfilter/nf_conntrack_acct 2>/dev/null)" = "1" ] || echo 1 > /proc/sys/net/netfilter/nf_conntrack_acct 2>/dev/null
+		fi
+		c=$((c + 1))
+		if [ "$en" = "0" ]; then
+			rm -f "$OUT" "$STATE"/*
+			sleep 10; continue
+		fi
+		w=$POLL
+		if [ -n "$lc" ] && [ -r "$CT" ]; then
+			cs; t0=$CS
+			run_once "$lc" "$wanip" "${wanstamp:-0}"
+			cs
+			# keep the work under about 5 % of the time: sleep at least 19x the run time
+			w=$(( (CS - t0) * 19 / 100 ))
+			[ $w -lt $POLL ] && w=$POLL
+			[ $w -gt 30 ] && w=30
+		fi
+		sleep $w
+	done
+	;;
+*)
+	[ -r "$OUT" ] && cat "$OUT" || echo "no data yet (Device Usage starts about 40 s after boot)"
+	;;
+esac
