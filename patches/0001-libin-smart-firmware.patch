+<script type="text/javascript" src="/popup.js"></script>
+<script>
+
+<% login_state_hook(); %>
+
+/* Device Usage page - Libin build */
+
+function fmt_rate(b){
+	if (b >= 1000000) return (b / 1000000).toFixed(2) + ' Mbps';
+	if (b >= 1000) return Math.round(b / 1000) + ' kbps';
+	return b > 0 ? Math.round(b) + ' bps' : '0';
+}
+
+function fmt_bytes(b){
+	if (b >= 1073741824) return (b / 1073741824).toFixed(2) + ' GB';
+	if (b >= 1048576) return (b / 1048576).toFixed(1) + ' MB';
+	if (b >= 1024) return Math.round(b / 1024) + ' KB';
+	return Math.round(b) + ' B';
+}
+
+function esc(s){
+	return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
+}
+
+function bar(v, max, color){
+	var w = max > 0 ? Math.min(100, Math.round(v * 100 / max)) : 0;
+	return '<div style="background:#333; height:4px; margin-top:3px; border-radius:2px;"><div style="width:' + w + '%; height:4px; background:' + color + '; border-radius:2px;"></div></div>';
+}
+
+function show_usage(text){
+	var lines = text.split('\n'), rows = [], i, p, max = 0, h = '', r;
+	for (i = 0; i < lines.length; i++) {
+		p = lines[i].split('|');
+		if (p.length < 7) continue;
+		rows.push({ip: p[0], mac: p[1], name: p[2], rd: +p[3], ru: +p[4], td: +p[5], tu: +p[6]});
+	}
+	rows.sort(function(a, b){ return (b.rd + b.ru) - (a.rd + a.ru) || (b.td + b.tu) - (a.td + a.tu); });
+	for (i = 0; i < rows.length; i++)
+		max = Math.max(max, rows[i].rd, rows[i].ru);
+	if (rows.length == 0)
+		h = '<tr><td colspan="6" style="text-align:center; color:#888;">No data yet. Device Usage starts about a minute after the router boots.</td></tr>';
+	for (i = 0; i < rows.length; i++) {
+		r = rows[i];
+		h += '<tr>';
+		h += '<td>' + (r.name != '-' ? esc(r.name) : '-') + '<div style="color:#888; font-size:11px;">' + esc(r.mac) + '</div></td>';
+		h += '<td>' + esc(r.ip) + '</td>';
+		h += '<td style="min-width:90px;"><span style="color:#FF9000;">&darr;</span> ' + fmt_rate(r.rd) + bar(r.rd, max, '#FF9000') + '</td>';
+		h += '<td style="min-width:90px;"><span style="color:#8e44f0;">&uarr;</span> ' + fmt_rate(r.ru) + bar(r.ru, max, '#8e44f0') + '</td>';
+		h += '<td>' + fmt_bytes(r.td) + '</td>';
+		h += '<td>' + fmt_bytes(r.tu) + '</td>';
+		h += '</tr>';
+	}
+	document.getElementById('du_rows').innerHTML = h;
+}
+
+function initial(){
+	show_banner(1);
+	show_menu(5,8,4);
+	show_footer();
+	load_body();
+	du_subscribe(show_usage);
+}
+</script>
